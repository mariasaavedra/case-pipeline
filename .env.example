# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Copy this to .env — the sync command loads it via --env-file automatically.
# =============================================================================

# Required: Monday.com API Token (shared service account for sync)
# Get yours at: https://monday.com/developers/apps
# Needed for the live sync (npm run sync:live) and the render pipeline.
MONDAY_API_TOKEN=your_api_token_here

# Monday.com OAuth app — for per-user note attribution
# Create an app at https://monday.com/developers/apps and set the redirect URI to:
#   {API_URL}/api/auth/monday/callback
MONDAY_CLIENT_ID=your_client_id_here
MONDAY_CLIENT_SECRET=your_client_secret_here

# URLs — used for OAuth redirects
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional: Monday.com webhooks (near-real-time mirror refresh; docs/webhooks.md).
# The shared secret that authenticates Monday's webhook deliveries — it becomes
# part of the callback URL (/api/webhooks/monday/<secret>). Generate with:
#   openssl rand -hex 32
# Set it here, redeploy the API, then register the webhooks:
#   npm run webhooks:setup -- --url=https://<public-host>
# MONDAY_WEBHOOK_SECRET=generate_a_long_random_hex_string

# Recommended (production): passphrase to encrypt database backups at rest.
# Backups (live.db, users.db) hold client PII + Monday tokens; when this is set
# they are written as AES-256-GCM `.db.enc` files. WITHOUT it, backups are
# plaintext. Store this key somewhere OTHER than the backups (a lost key means
# lost backups). Restore with: npx tsx scripts/restore-backup.ts <file.db.enc>
# BACKUP_ENCRYPTION_KEY=generate_a_long_random_passphrase

# Recommended (production): passphrase to encrypt per-user secrets at rest.
# Monday.com OAuth tokens (and future per-user credentials) in users.db are
# encrypted column-side (AES-256-GCM) when this is set; WITHOUT it they are
# stored in plaintext (the app warns on boot). Kept separate from
# BACKUP_ENCRYPTION_KEY on purpose. Generate one with: openssl rand -base64 48
# APP_ENCRYPTION_KEY=generate_a_long_random_passphrase

# Optional: enable the scheduled Monday.com syncs (default: OFF).
# Two schedules with very different costs:
#   full        — walks every board + every timeline. The ONLY pass that detects
#                 deletions and pulls Emails & Activities. Hours.
#   incremental — only board items whose Monday updated_at moved; skips the
#                 timeline. Minutes.
# Overlapping runs are skipped, so a long full pass can't pile up behind itself.
# NIGHTLY_SYNC=on
# SYNC_FULL_CRON=0 1 * * *          # default: 01:00 daily
# SYNC_INCREMENTAL_CRON=0 7-19/2 * * *   # default: every 2h, 07:00–19:00
#
# Safety net (always on): a full sync snapshots live.db to
# data/backups/live-presync-<stamp>.db BEFORE touching it, and ABORTS if that
# snapshot fails. Restore is a plain file copy over data/live.db. The daily 05:30
# cron keeps a separate live-<stamp> series.
#
# How many daily backups to retain (default 4). At ~820 MB each, more than a
# handful fills a small disk — a full disk mid-sync was the root cause of the
# 2026-07 corruptions (see docs/nightly/2026-07-27.md). Raise only with disk to spare.
# BACKUP_KEEP=4

# Optional: SharePoint folder automation (scripts/sharepoint-folders.ts).
# By default this needs NOTHING here: it signs in as a person via the device code
# flow against the dashboard's existing app registration, using the delegated
# Files.ReadWrite.All grant that is already admin-consented.
#   npm run sharepoint:folders -- --login
# The refresh token is stored in data/.graph-token.json (gitignored, owner-only,
# encrypted when APP_ENCRYPTION_KEY is set). See docs/sharepoint-folders.md.
#
# Set GRAPH_CLIENT_SECRET only to switch to fully-unattended app-only auth, which
# additionally requires an APPLICATION permission (Sites.Selected + per-site
# grants) and admin consent on the registration.
# GRAPH_CLIENT_SECRET=the_client_secret_value
# GRAPH_CLIENT_ID=...     # defaults to the dashboard's app registration
# GRAPH_TENANT_ID=...     # defaults to the firm's tenant

# Optional: consult folder sweep (default: OFF) — the Calendly→Zapier replacement.
# For each Calendly consultation that HAS TAKEN PLACE and has no folder recorded,
# records the folder that already exists or creates one in SCAL Consults, then
# writes the URL to the profile. Cancelled, no-show and still-upcoming consults
# are left alone. See docs/sharepoint-folders.md.
#
# Requires a signed-in Graph token ON THE HOST — run once, on the server:
#   npm run sharepoint:folders -- --login
# CONSULT_FOLDERS=on
# CONSULT_SWEEP_CRON=30 7-19/2 * * *   # default: :30 past, every 2h, 07:00–19:00
# CONSULT_SWEEP_DAYS=45                # how far back to look each run

# Optional: Which local database the API and tools read from (default: seed)
#   seed → data/seed.db  (Faker.js data, safe to regenerate, used by CI)
#   live → data/live.db  (real Monday.com data, gitignored, local only)
# DB_SOURCE=seed

# Optional: API bind address + port (defaults: 127.0.0.1:3000)
# Locally keep the loopback default — the API is unauthenticated and serves PII.
# In a container behind nginx (no published port) set HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=3000

# Required: Item ID to process (for main pipeline)
ITEM_ID=your_item_id_here

# Optional: Template to render (default: client_letter)
TEMPLATE_NAME=client_letter

# Optional: Output directory for rendered files (default: output)
OUTPUT_DIR=output

# Optional: Override board IDs from config/boards.yaml
# PROFILES_BOARD_ID=18397286934
# CONTRACTS_BOARD_ID=18397312752

# Optional: Monday.com API version (default: 2024-10)
# See: https://developer.monday.com/api-reference/docs/api-versioning
# MONDAY_API_VERSION=2024-10
